# Optional overrides for Docker profile.
# App uses Docker DB by default (db:3306).

# Uncomment only for temporary MAMP fallback.
# DOCKER_APP_DB_HOST=host.docker.internal
# DOCKER_APP_DB_PORT=8889

# Host ports
DOCKER_DB_PORT=3307
DOCKER_ADMINER_PORT=8082

# Public base URL used in reset links
APP_URL=http://localhost:8081

# SMTP configuration for password reset emails
# For Microsoft 365, make sure SMTP AUTH is enabled for the mailbox.
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=innovacion@aia.com.co
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=innovacion@aia.com.co
MAIL_FROM_NAME="Last Planner AIA"
