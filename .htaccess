<IfModule mod_rewrite.c>
    RewriteEngine On

    # 0. Mapear rutas de FrontEnd y assets absolutos a /public en local
    RewriteCond %{REQUEST_URI} ^/(css|js|img|vendor|storage|archivosBase|pdc-app|ct-app)/(.*)$ [NC]
    RewriteRule ^(.*)$ public/%{REQUEST_URI} [L]

    # El bundle de la SPA se publica bajo /app, sin enviarlo al front controller.
    # El directorio no se lista ni se despacha como PHP: responde 404 controlado.
    RewriteRule ^app/assets/?$ - [R=404,L]
    RewriteRule ^app/assets/(.*)$ public/app/assets/$1 [L,NC]

    # 1. Si el archivo existe físicamente, sírvelo directamente (Legacy Support de Assets)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 2. Todo lo demás (URLs y directorios), redirígelo al Front Controller en public/index.php
    RewriteRule ^(.*)$ public/index.php [QSA,L]
</IfModule>
