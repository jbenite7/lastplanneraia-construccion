Options -Indexes
RewriteEngine On

# 1. Heredar el prefijo /construccion/ para assets (CSS, JS, IMAGES)
# Redirige /construccion/css/styles.css -> /css/styles.css
RewriteRule ^construccion/(css|js|imagenes|archivosBase|vendor|storage)/(.*)$ $1/$2 [L,NC]

# 2. Rutas estándar del Front Controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
