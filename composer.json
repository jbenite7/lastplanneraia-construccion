{
    "require": {
        "phpoffice/phpspreadsheet": "^5.4",
        "vlucas/phpdotenv": "^5.6",
        "nikic/fast-route": "^1.3",
        "phpmailer/phpmailer": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "Admin\\": "admin/src/",
            "App\\": "src/"
        },
        "classmap": [
            "src/Core/Database.php",
            "src/Core/TableResolver.php"
        ]
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.93",
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "test": "php scripts/run-php-tests.php --nivel=http",
        "test:puro": "php scripts/run-php-tests.php --nivel=puro",
        "test:datos-proyecto": "php scripts/run-php-tests.php --nivel=datos-proyecto"
    }
}
