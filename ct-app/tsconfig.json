{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    // Sin esto, `@types/node` (que necesita vite.config.ts) quedaría visible para el código de
    // navegador de `src/`. La configuración de Vite se comprueba aparte, en tsconfig.node.json.
    "types": []
  },
  "include": ["src"]
}
