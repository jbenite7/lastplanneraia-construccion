<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Redirigir siempre a HTTPS si está disponible
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # No aplicar reglas si el archivo o carpeta existen físicamente (CSS, JS, Imágenes)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Redirigir todo lo demás al Front Controller (index.php)
    RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]
</IfModule>

# Seguridad Extra: Impedir el listado de directorios
Options -Indexes

# Bloquear acceso a archivos sensibles
<FilesMatch "\.(env|log|json|lock)$">
    Order allow,deny
    Deny from all
</FilesMatch>
