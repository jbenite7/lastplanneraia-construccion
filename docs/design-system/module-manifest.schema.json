{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lastplanneraia.com/schemas/design-system/module-manifest.schema.json",
  "title": "AIA design-system module manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "designSystemVersion",
    "moduleId",
    "routes",
    "sources",
    "components",
    "vendors",
    "layouts",
    "states",
    "roles",
    "persistence",
    "exceptions",
    "tests",
    "evidence",
    "scenarios"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Declarado por los 15 manifiestos para que el editor resuelva este esquema. Se lista aqui porque el gate aplica additionalProperties: false sobre los manifiestos y, sin esta entrada, la propia autorreferencia seria una propiedad no declarada."
    },
    "schemaVersion": {
      "const": 2
    },
    "designSystemVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "moduleId": {
      "type": "string"
    },
    "consumerContract": {
      "enum": [
        "v1"
      ]
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vendors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "layouts": {
      "type": "array",
      "items": {
        "enum": [
          "mobile",
          "tablet",
          "desktop",
          "wide"
        ]
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "persistence": {
      "type": "object"
    },
    "exceptions": {
      "type": "array"
    },
    "tests": {
      "type": "array"
    },
    "evidence": {
      "type": "array"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "viewport": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 320
        },
        "height": {
          "type": "integer",
          "minimum": 568
        }
      }
    },
    "scenario": {
      "type": "object",
      "required": [
        "id",
        "family",
        "route",
        "fixture",
        "theme",
        "viewport",
        "density",
        "state",
        "role",
        "golden",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "family": {
          "type": [
            "string",
            "null"
          ]
        },
        "route": {
          "type": "string"
        },
        "fixture": {
          "type": "string"
        },
        "theme": {
          "enum": [
            "dark"
          ]
        },
        "viewport": {
          "$ref": "#/$defs/viewport"
        },
        "density": {
          "enum": [
            "compact",
            "touch"
          ]
        },
        "state": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "golden": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "capture": {
          "enum": ["viewport", "element"],
          "description": "viewport: captura de pantalla completa, el PNG mide exactamente el viewport declarado. element: recorte a un elemento, el PNG puede ser menor. Si se omite, viewport."
        }
      }
    }
  }
}
