{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lastplanneraia.com/schemas/design-system/module-manifest.schema.json",
  "title": "AIA design-system module manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "designSystemVersion",
    "moduleId",
    "routes",
    "sources",
    "components",
    "vendors",
    "layouts",
    "states",
    "roles",
    "persistence",
    "exceptions",
    "tests",
    "evidence",
    "scenarios"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Declarado por los 15 manifiestos para que el editor resuelva este esquema. Se lista aqui porque el gate aplica additionalProperties: false sobre los manifiestos y, sin esta entrada, la propia autorreferencia seria una propiedad no declarada."
    },
    "schemaVersion": {
      "const": 2
    },
    "designSystemVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "moduleId": {
      "type": "string"
    },
    "consumerContract": {
      "enum": [
        "v1"
      ]
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vendors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "layouts": {
      "type": "array",
      "items": {
        "enum": [
          "mobile",
          "tablet",
          "desktop",
          "wide"
        ]
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "persistence": {
      "type": "object"
    },
    "exceptions": {
      "type": "array"
    },
    "tests": {
      "type": "array"
    },
    "evidence": {
      "type": "array"
    },
    "scenarios": {
      "type": "array",
      "description": "Escenarios propios del modulo. El minimo NO se declara aqui con minItems porque depende de visualEvidence: sin visualEvidence el gate exige al menos uno (regla por defecto, la estricta); con visualEvidence el modulo delega su evidencia en una familia de homologation.json y este array debe quedar vacio. Ambas ramas las aplica scripts/design-system-contracts.mjs.",
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "visualEvidence": {
      "type": "object",
      "description": "Solo para modulos transversales que no tienen pantalla propia que capturar (hoy unicamente foundation-shell, que es el shell y la barra lateral de toda la aplicacion). Su ausencia es la regla por defecto y la estricta: el modulo debe traer sus propios escenarios. Declararlo no exime de evidencia, la senala en otro sitio, y el gate comprueba que ese sitio existe y no esta vacio.",
      "additionalProperties": false,
      "required": [
        "source",
        "family"
      ],
      "properties": {
        "source": {
          "const": "delegated-family"
        },
        "family": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "viewport": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 320
        },
        "height": {
          "type": "integer",
          "minimum": 568
        }
      }
    },
    "scenario": {
      "type": "object",
      "required": [
        "id",
        "family",
        "route",
        "fixture",
        "theme",
        "viewport",
        "density",
        "state",
        "role",
        "golden",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "family": {
          "type": [
            "string",
            "null"
          ]
        },
        "route": {
          "type": "string"
        },
        "fixture": {
          "type": "string"
        },
        "theme": {
          "enum": [
            "dark"
          ]
        },
        "viewport": {
          "$ref": "#/$defs/viewport"
        },
        "density": {
          "enum": [
            "compact",
            "touch"
          ]
        },
        "state": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "golden": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "capture": {
          "enum": [
            "viewport",
            "element"
          ],
          "description": "viewport: captura de pantalla completa, el PNG mide exactamente el viewport declarado. element: recorte a un elemento, el PNG puede ser menor. Si se omite, viewport."
        },
        "goldenPlatforms": {
          "type": "object",
          "description": "Gemelos del golden en otras plataformas. macOS usa `golden`/`sha256`; aqui se declara el juego que rinde CI. Existe porque el trazado de fuentes difiere entre plataformas y un solo juego no puede vigilar las dos (D-GAC-4). Cada gemelo se ancla por ruta y sha256 igual que el principal: ninguno queda sin vigilancia.",
          "additionalProperties": false,
          "properties": {
            "linux": {
              "type": "object",
              "required": [
                "golden",
                "sha256"
              ],
              "additionalProperties": false,
              "properties": {
                "golden": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
