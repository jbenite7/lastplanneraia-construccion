{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lastplanneraia.com/schemas/design-system-family-approvals.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "designSystemVersion",
    "approvals"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "designSystemVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "approvals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/approval"
      }
    }
  },
  "$defs": {
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "familyId",
        "candidateId",
        "approvedBy",
        "approvalRef",
        "approvedAt",
        "themes",
        "viewports",
        "evidence"
      ],
      "properties": {
        "familyId": {
          "type": "string",
          "minLength": 1
        },
        "candidateId": {
          "type": "string",
          "minLength": 1
        },
        "approvedBy": {
          "type": "string",
          "minLength": 1
        },
        "approvalRef": {
          "type": "string",
          "minLength": 1
        },
        "approvedAt": {
          "type": "string",
          "format": "date"
        },
        "scope": {
          "type": "string",
          "enum": [
            "desktop-dark"
          ]
        },
        "themes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "dark"
            ]
          }
        },
        "viewports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "1180x820",
              "1440x900"
            ]
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
