{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lastplanneraia.com/schemas/design-system/evidence-exceptions.schema.json",
  "title": "Design System AIA visual evidence exceptions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "designSystemVersion",
    "elementCaptureAllowlist",
    "visualEvidenceDelegationAllowlist"
  ],
  "properties": {
    "designSystemVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "elementCaptureAllowlist": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "moduleId",
          "scenarioId",
          "width",
          "height",
          "owner",
          "reason"
        ],
        "properties": {
          "moduleId": {
            "type": "string",
            "minLength": 1
          },
          "scenarioId": {
            "type": "string",
            "minLength": 1
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "visualEvidenceDelegationAllowlist": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "moduleId",
          "delegatesToFamily",
          "owner",
          "reason"
        ],
        "properties": {
          "moduleId": {
            "type": "string",
            "minLength": 1
          },
          "delegatesToFamily": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
