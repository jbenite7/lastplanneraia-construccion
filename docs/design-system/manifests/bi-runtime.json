    "chartjs"
  ],
  "layouts": [
    "desktop"
  ],
  "states": [
    "normal"
  ],
  "roles": [
    "authenticated-project-member"
  ],
  "persistence": {
    "session": "authenticated project selection",
    "localStorage": "aia-sidebar-state"
  },
  "exceptions": [
    {
      "id": "bi-chart-theme-fallbacks",
      "reason": "public/js/modules/bi_chart_theme.js conserva SERIES_FALLBACKS y TEXT_FALLBACKS en hex. No son deuda por tokenizar: el modulo lee los tokens vivos con getComputedStyle(document.documentElement) (--ds-active-text-primary, --ds-active-border, --ds-active-surface, --ds-active-surface-raised y las seis series) y el hex solo entra si el token no resuelve, caso en que Chart.js pintaria transparente. Su procedencia esta documentada y validada para dark con scripts/validate_palette.js. Queda registrado como excepcion permanente en docs/design-system/exceptions.json (presupuesto bi-chart-theme-fallbacks), no como pendiente.",
      "scope": "public/js/modules/bi_chart_theme.js",
      "status": "permanent"
    }
  ],
  "tests": [
    "tests/browser/bi_control_tower.spec.mjs",
    "tests/browser/bi_control_tower_access.spec.mjs"
  ],
  "evidence": [
    "tests/browser/__screenshots__/bi-runtime/"
