{
  "$schema": "../module-manifest.schema.json",
  "schemaVersion": 2,
  "designSystemVersion": "1.1.0",
  "moduleId": "auth",
  "routes": [
    "/",
    "/login",
    "/password/forgot",
    "/password/reset"
  ],
  "sources": [
    "frontend/index.html",
    "frontend/src/shell/auth/MarcoAcceso.tsx",
    "frontend/src/shell/auth/PantallaLogin.tsx",
    "frontend/src/shell/auth/CampoClave.tsx",
    "frontend/src/shell/auth/CambioClaveObligatorio.tsx",
    "frontend/src/shell/auth/avisos.ts",
    "frontend/src/shell/ConmutadorTema.tsx",
    "public/css/auth-react.css",
    "views/auth/login.view.php",
    "views/auth/password-forgot.view.php",
    "views/auth/password-reset.view.php",
    "public/css/login-brand-unified.css"
  ],
  "components": [
    "shell",
    "card",
    "field",
    "button",
    "state",
    "feedback"
  ],
  "vendors": [
    "bootstrap",
    "font-awesome",
    "aia-fonts",
    "sweetalert2",
    "adminlte"
  ],
  "layouts": [
    "desktop",
    "mobile",
    "tablet",
    "wide"
  ],
  "states": [
    "normal",
    "error",
    "focus",
    "busy",
    "password-change",
    "cancel-confirmation"
  ],
  "roles": [
    "anonymous",
    "pending-password"
  ],
  "persistence": {
    "session": "none (pre-authentication surfaces)",
    "theme": "claro por defecto sin flash; se alterna con ConmutadorTema (frontend/src/shell/ConmutadorTema.tsx) y persiste por aparato en localStorage bajo 'aia-theme' (frontend/src/shell/tema.ts). El login legacy (login.view.php, S02/S03) sigue en dark-only via theme.js sin migrar; este campo describe el login React ya migrado en esta tarea, no el resto del módulo."
  },
  "exceptions": [],
  "tests": [
    "tests/browser/design-system-consumer-smoke.mjs",
    "tests/browser/entrypoint-segmentation-dryrun.mjs"
  ],
  "evidence": [
    "docs/design-system/evidence/entrypoint-segmentation/auth/"
  ],
