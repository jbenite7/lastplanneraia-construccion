{
  "$schema": "../module-manifest.schema.json",
  "schemaVersion": 2,
  "designSystemVersion": "1.1.0",
  "moduleId": "auth",
  "routes": [
    "/",
    "/login",
    "/password/forgot",
    "/password/reset"
  ],
  "sources": [
    "frontend/index.html",
    "frontend/src/shell/auth/MarcoAcceso.tsx",
    "frontend/src/shell/auth/PantallaLogin.tsx",
    "frontend/src/shell/auth/PantallaRecuperarClave.tsx",
    "frontend/src/shell/auth/PantallaRestablecerClave.tsx",
    "frontend/src/shell/auth/tokenReset.ts",
    "frontend/src/shell/auth/iconos.tsx",
    "frontend/src/shell/auth/CampoClave.tsx",
    "frontend/src/shell/auth/CambioClaveObligatorio.tsx",
    "frontend/src/shell/auth/avisos.ts",
    "frontend/src/shell/ConmutadorTema.tsx",
    "public/css/auth-react.css",
    "views/auth/login.view.php",
    "views/auth/password-reset.view.php",
    "public/css/login-brand-unified.css"
  ],
  "components": [
    "shell",
    "card",
    "field",
    "button",
    "state",
    "feedback"
  ],
  "vendors": [
    "bootstrap",
    "font-awesome",
    "aia-fonts",
    "sweetalert2",
    "adminlte"
  ],
  "layouts": [
    "desktop",
    "mobile",
    "tablet",
    "wide"
  ],
  "states": [
    "normal",
    "error",
    "focus",
    "busy",
    "password-change",
    "cancel-confirmation",
    "recovery-initial",
    "recovery-invalid",
    "recovery-busy",
    "recovery-accepted",
    "recovery-csrf",
    "recovery-unavailable",
    "recovery-network",
    "reset-validating",
    "reset-invalid",
    "reset-form",
    "reset-field-error",
    "reset-busy",
    "reset-csrf",
    "reset-unavailable",
    "reset-network"
  ],
  "roles": [
    "anonymous",
    "pending-password"
  ],
  "persistence": {
    "session": "none (pre-authentication surfaces)",
    "theme": "claro por defecto sin flash; se alterna con ConmutadorTema (frontend/src/shell/ConmutadorTema.tsx) y persiste por aparato en localStorage bajo 'aia-theme' (frontend/src/shell/tema.ts). El login legacy (login.view.php) y VIEW-03 (password-reset.view.php, fuente de rollback de S03 hasta su Tarea 10) siguen en dark-only via theme.js; este campo describe las pantallas React migradas (login, recuperación y restablecimiento)."
  },
  "exceptions": [],
  "tests": [
    "tests/browser/design-system-consumer-smoke.mjs",
    "tests/browser/entrypoint-segmentation-dryrun.mjs"
  ],
  "evidence": [
    "docs/design-system/evidence/entrypoint-segmentation/auth/"
  ],
