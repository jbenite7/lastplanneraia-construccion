{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lastplanneraia.com/schemas/design-system/component-catalog.schema.json",
  "title": "AIA design-system component catalog",
  "type": "object",
  "required": [
    "schemaVersion",
    "designSystemVersion",
    "components"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Declarado por el documento para que el editor resuelva este esquema. Se lista aqui porque el gate aplica additionalProperties: false sobre el documento y, sin esta entrada, la propia autorreferencia seria una propiedad no declarada."
    },
    "schemaVersion": {
      "const": 2
    },
    "designSystemVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "$defs": {
    "visualApproval": {
      "type": "object",
      "required": [
        "status",
        "familyId",
        "candidateId"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "approved",
            "pending",
            "not-required"
          ]
        },
        "familyId": {
          "type": "string"
        },
        "candidateId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "shape": {
      "type": "object",
      "required": [
        "radius",
        "border",
        "floor"
      ],
      "additionalProperties": false,
      "properties": {
        "radius": {
          "type": "string",
          "pattern": "^--ds-radius-"
        },
        "border": {
          "type": "string"
        },
        "floor": {
          "enum": [
            "rest",
            "float",
            "top",
            "none"
          ]
        },
        "cssFile": {
          "type": "string"
        }
      }
    },
    "component": {
      "type": "object",
      "required": [
        "id",
        "family",
        "kind",
        "maturity",
        "visualApproval",
        "shape",
        "purpose",
        "doNotUseFor",
        "api",
        "markup",
        "variants",
        "states",
        "densities",
        "tokens",
        "responsive",
        "accessibility",
        "testSelector",
        "consumers",
        "replacement",
        "golden"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "canonical",
            "adapter",
            "legacy",
            "missing"
          ]
        },
        "maturity": {
          "enum": [
            "stable",
            "candidate",
            "compatibility",
            "deprecated"
          ]
        },
        "visualApproval": {
          "$ref": "#/$defs/visualApproval"
        },
        "shape": {
          "$ref": "#/$defs/shape"
        },
        "purpose": {
          "type": "string"
        },
        "doNotUseFor": {
          "type": "string"
        },
        "api": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "markup": {
          "type": "string"
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "densities": {
          "type": "array",
          "items": {
            "enum": [
              "compact",
              "touch"
            ]
          }
        },
        "tokens": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "responsive": {
          "type": "array",
          "items": {
            "enum": [
              "mobile",
              "tablet",
              "desktop",
              "wide"
            ]
          }
        },
        "accessibility": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "testSelector": {
          "type": "string"
        },
        "consumers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "replacement": {
          "type": [
            "string",
            "null"
          ]
        },
        "golden": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
