{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lastplanneraia.com/schemas/design-system/stable-api.schema.json",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "designSystemVersion",
    "targetVersion",
    "releaseStatus",
    "guaranteeScope",
    "activationGate",
    "components"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "./stable-api.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "designSystemVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "targetVersion": {
      "const": "1.0.0"
    },
    "releaseStatus": {
      "enum": [
        "pending-gates",
        "guaranteed"
      ]
    },
    "guaranteeScope": {
      "const": "stable-only"
    },
    "activationGate": {
      "const": "all-closeout-gates-passed"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "required": [
        "id",
        "family",
        "api",
        "evidenceSurfaces"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "api": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidenceSurfaces": {
          "type": "array",
          "prefixItems": [
            {
              "const": "laboratory"
            },
            {
              "const": "programa-general"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      }
    }
  }
}
