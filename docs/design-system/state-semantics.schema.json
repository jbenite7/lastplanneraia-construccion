{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lastplanneraia.com/design-system/state-semantics.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "designSystemVersion",
    "purpose",
    "dimensions",
    "axisRules",
    "levels",
    "hues",
    "translationRules",
    "moduleMappings"
  ],
  "properties": {
    "designSystemVersion": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "urgency"
      ],
      "properties": {
        "severity": {
          "type": "array"
        },
        "urgency": {
          "type": "array"
        }
      }
    },
    "axisRules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Reglas de reparto de ejes: que codifica cada canal visual. Se anade el 2026-08-19 con el frente ds-f1a-estados-severidad. Es requerida a proposito: un contrato de estados que no diga que hace cada canal deja el reparto al criterio de cada hoja, y eso es exactamente lo que produjo que el fondo intentara decir identidad y gravedad a la vez."
    },
    "levels": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "token",
          "severity",
          "urgency",
          "action",
          "examples"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "urgency": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "examples": {
            "type": "array"
          }
        }
      }
    },
    "hues": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "tint",
          "solid",
          "solidText",
          "row"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "tint": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "solid": {
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
          },
          "solidText": {
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
          },
          "row": {
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
          }
        }
      }
    },
    "translationRules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "moduleMappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module",
          "surface",
          "states"
        ],
        "properties": {
          "module": {
            "type": "string"
          },
          "surface": {
            "type": "string",
            "minLength": 1,
            "description": "Donde se pintan estos estados: una ruta de public/index.php. Obligatoria desde D-CEF-1 (2026-08-12): sin superficie declarada no hay nada contra lo que contrastar, y un modulo que no pinta ningun estado entra en el contrato sin que ningun gate pueda notarlo. Paso el 2026-07-15 con programa-general-actualizar, que declaro seis estados inventados y estuvo un mes en verde."
          },
          "states": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "level"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                },
                "level": {
                  "type": "string"
                },
                "hue": {
                  "type": "string"
                },
                "note": {
                  "type": "string",
                  "description": "Anotacion opcional de procedencia: por que este estado tiene el level/hue que tiene cuando la eleccion no es obvia o corrige un mapeo anterior. Hoy la usa execution-blocked, que registra la ratificacion del propietario del producto del 2026-08-03 y el mapeo obsoleto que sustituye."
                },
                "rail": {
                  "enum": [
                    "ready"
                  ],
                  "description": "Marcador positivo escaso (Felipe 2026-08-20): filete verde 3px solo en lo activamente listo, declarado por estado — nunca derivado de nivel+matiz ni aplicado a todo Controlado."
                },
                "displayShort": {
                  "type": "string",
                  "description": "Nombre corto OFICIAL que la celda pinta cuando el completo no cabe (decision de Felipe 2026-08-20). El completo nunca se pierde: vive en tooltip, aria-label y drawer."
                }
              }
            }
          },
          "labelBudgetPx": {
            "type": "integer",
            "minimum": 1,
            "description": "Ancho util en px del texto en la celda de estado, regimen normal."
          },
          "labelFloorBudgetPx": {
            "type": "integer",
            "minimum": 1,
            "description": "Ancho util en el regimen comprimido de la tabla. DERIVADO: pendiente de confirmar en pantalla."
          },
          "labelLines": {
            "enum": [
              1,
              2
            ],
            "description": "Lineas que admite la celda. 1 exige que el label efectivo quepa entero; 2 admite envolver ENTRE palabras, que no es recortar."
          }
        }
      }
    },
    "brandAudit": {
      "type": "string"
    },
    "labelBudgetNota": {
      "type": "string"
    }
  }
}
