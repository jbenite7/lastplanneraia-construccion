{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lastplanneraia.com/design-system/state-semantics.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "designSystemVersion",
    "purpose",
    "dimensions",
    "levels",
    "hues",
    "translationRules",
    "moduleMappings"
  ],
  "properties": {
    "designSystemVersion": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "urgency"
      ],
      "properties": {
        "severity": {
          "type": "array"
        },
        "urgency": {
          "type": "array"
        }
      }
    },
    "levels": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "token",
          "severity",
          "urgency",
          "action",
          "examples"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "urgency": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "examples": {
            "type": "array"
          }
        }
      }
    },
    "hues": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "tint"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "tint": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "translationRules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "moduleMappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module",
          "surface",
          "states"
        ],
        "properties": {
          "module": {
            "type": "string"
          },
          "surface": {
            "type": "string",
            "minLength": 1,
            "description": "Donde se pintan estos estados: una ruta de public/index.php. Obligatoria desde D-CEF-1 (2026-08-12): sin superficie declarada no hay nada contra lo que contrastar, y un modulo que no pinta ningun estado entra en el contrato sin que ningun gate pueda notarlo. Paso el 2026-07-15 con programa-general-actualizar, que declaro seis estados inventados y estuvo un mes en verde."
          },
          "states": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "level"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                },
                "level": {
                  "type": "string"
                },
                "hue": {
                  "type": "string"
                },
                "note": {
                  "type": "string",
                  "description": "Anotacion opcional de procedencia: por que este estado tiene el level/hue que tiene cuando la eleccion no es obvia o corrige un mapeo anterior. Hoy la usa execution-blocked, que registra la ratificacion del propietario del producto del 2026-08-03 y el mapeo obsoleto que sustituye."
                }
              }
            }
          }
        }
      }
    }
  }
}
