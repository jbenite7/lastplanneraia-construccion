{
  "scripts": {
    "check:frontend": "biome check public/js public/css admin/public/css",
    "check:design-system:biome": "biome check public/css/design-system public/js/modules/aia_ui",
    "format:frontend": "biome format --write public/js public/css admin/public/css",
    "lint:frontend": "biome lint public/js public/css admin/public/css",
    "test:design-system:preservation": "node scripts/design-system-worktree-preservation.mjs check goals/design-system-nucleo-gobernanza/worktree-preservation.json",
    "test:wiki": "node --test 'tests/wiki/*.test.mjs' && node scripts/wiki-lint.mjs --estricto",
    "test:design-system:static": "node scripts/design-system-static-suite.mjs",
    "test:design-system:consumers": "node scripts/design-system-consumer-contract.mjs",
    "test:design-system:phpstan": "node scripts/design-system-phpstan-baseline.mjs",
    "test:pi-ancho-presupuesto": "node tests/browser/pi-ancho-presupuesto.mjs",
    "test:pdc:phpstan": "docker compose exec -T app vendor/bin/phpstan analyse -c phpstan-pdc.neon --memory-limit=1G --no-progress",
    "test:design-system:runtime": "playwright test tests/browser/design-system-lab.mjs tests/browser/design-system-body-canvas-dark.mjs tests/browser/design-system-unlayered-delivery.mjs tests/browser/design-system-table-contract.runtime.mjs --workers=1 && npm run test:a11y:lab && npm run test:visual:lab && npm run test:performance:lab",
    "test:design-system:evidence": "playwright test tests/browser/design-system-lab-keyboard.mjs tests/browser/design-system-lab-desktop-layout.mjs --workers=1",
    "test:a11y:lab": "playwright test tests/browser/design-system-lab.a11y.mjs --workers=1",
    "test:a11y:pilot": "playwright test tests/browser/programa-general-design-system.mjs --workers=1",
    "test:keyboard": "playwright test tests/browser/design-system-lab-keyboard.mjs --workers=1",
    "test:desktop-layout:lab": "playwright test tests/browser/design-system-lab-desktop-layout.mjs --workers=1",
    "test:reflow": "playwright test tests/browser/design-system-lab-desktop-layout.mjs --workers=1",
    "test:visual:lab": "playwright test tests/browser/design-system-lab.visual.mjs --workers=1",
    "test:visual:pilot": "playwright test tests/browser/programa-general.visual.mjs --workers=1",
    "test:hue:pilot": "playwright test tests/browser/programa-general-state-hue.mjs --workers=1",
    "test:performance:lab": "playwright test tests/browser/design-system-lab.performance.mjs --workers=1",
    "test:runtime-budget:measure": "playwright test tests/browser/design-system-runtime-budget.mjs --workers=1",
    "test:runtime-budget:check": "node scripts/design-system-runtime-budget.mjs check docs/design-system/runtime-baseline-0.4.0.json test-output/design-system-runtime-budget.json",
    "css:minify": "node scripts/css-minify.mjs",
    "css:minify:check": "node scripts/css-minify.mjs --verificar",
    "css:minify:parity": "node tests/design-system/css-minify-parity.mjs",
    "test:rbac-parity": "node --test 'tests/rbac/*.test.mjs'",
    "check:vendor": "node scripts/sync-vendor.mjs --check",
    "sync:vendor": "node scripts/sync-vendor.mjs --write",
    "test:wiki:forma": "node scripts/wiki-lint.mjs --estricto --sin-alarma"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "2.5.4",
    "@playwright/test": "^1.61.1",
    "bootstrap": "4.3.1",
    "chart.js": "4.4.1",
    "datatables.net": "1.10.21",
    "handsontable": "14.6.1",
    "icheck-bootstrap": "3.0.1",
    "jquery": "3.6.0",
    "jquery-ui": "1.14.2",
    "jszip": "3.5.0",
    "lucide": "1.27.0",
    "pdfmake": "0.1.70",
    "popper.js": "1.16.1",
    "select2": "4.0.13",
    "sweetalert2": "11.4.24",
    "toastr": "2.1.4",
    "tom-select": "2.3.1"
  }
}
